# Snowflake Postgres Mirror HOL - Environment Configuration Template
# Copy this file to mirror.env and fill in your values
#
# Usage:
#   cp .env/mirror.env.template .env/mirror.env
#   # Then edit .env/mirror.env with your actual values
#
# Comment convention:
#   (default: X) code falls back to X if this var is unset
#
# All other vars below are required — this file is the single source of truth
# for the Snowflake SQL, the Postgres SQL, the helper scripts, and notebook
# generation; a missing var is an error.
#
# Override any value for a single run from your shell, e.g.:
#   POSTGRES_INSTANCE_MODE=existing task demo-up

# ################################################
# Postgres Instance Mode
# ################################################
# Controls where the source Snowflake Postgres instance comes from:
#   "create"   - demo-up creates a new instance plus a POSTGRES_INGRESS network
#                policy for your IP; demo-teardown drops both
#   "existing" - use an instance your MIRROR_ADMIN_ROLE_NAME already owns; the lab
#                never creates/drops it or changes its network policy. You provide
#                connectivity and a saved ~/.pg_service.conf + ~/.pgpass entry.
# (default: create)
POSTGRES_INSTANCE_MODE=create

# ################################################
# Snowflake Connection
# ################################################

# snow CLI connection (from ~/.snowflake/connections.toml or config.toml) used by
# every task. The lab runs many CLI commands, so prefer non-interactive auth
# (key-pair, PAT, or password); browser SSO prompts on every command unless
# token caching is enabled.
CLI_CONNECTION_NAME=my_connection

# Role that creates and owns the Postgres instance, the network policy, and the
# mirror. Mirror procedures require the caller to OWN the source instance and to
# hold the snowflake.postgres_mirror_admin application role. Lab-1 grants that
# role as ACCOUNTADMIN; if you can't use ACCOUNTADMIN, have an admin grant it.
MIRROR_ADMIN_ROLE_NAME=ACCOUNTADMIN

# ################################################
# Warehouse
# ################################################

DEMO_WAREHOUSE_NAME=COMPUTE_WH

# ################################################
# Lab Database (lab-owned helper objects)
# ################################################

# Holds the Postgres ingress network rule, the notebook and its stage, and the
# lab-7 analytics objects. The mirror's target database is separate and is
# created by CREATE_MIRROR (see Mirror below).
DEMO_DATABASE_NAME=POSTGRES_MIRROR_HOL
DEMO_DATABASE_DDL_COMMENT='Snowflake Postgres mirror hands-on lab'
# Schema name only — do NOT include the database prefix.
DEMO_SCHEMA_NAME=LAB
# Bare name only (no @ prefix, no database/schema qualifier).
DEMO_INTERNAL_NAMED_STAGE=LAB_STAGE
DEMO_INTERNAL_NAMED_STAGE_COMMENT='Internal stage for notebook artifacts'
DEMO_NOTEBOOK_NAME=IOT_MIRROR_LAB_NOTEBOOK

# ################################################
# Roles
# ################################################

# Created if it does not exist. lab-1 grants it the mirror's <TARGET>_ADMIN
# database role, which is how read access to mirrored data is delegated.
DEMO_ANALYST_ROLE_NAME=IOT_MIRROR_ANALYST

# ################################################
# Snowflake Postgres Instance
# ################################################

# Exact, case-sensitive instance name. Create mode: UPPERCASE letters, digits,
# and underscores. Existing mode: the name exactly as SHOW POSTGRES INSTANCES
# displays it.
PG_INSTANCE_NAME=IOT_MIRROR_LAB

# Create mode only. BURST_* families are not supported for mirroring.
# STANDARD_M (1 core / 4 GB) is enough for this lab, but it is AWS-only:
# on Azure use STANDARD_L (create mode stops early if STANDARD_M is set there).
PG_COMPUTE_FAMILY=STANDARD_M
PG_STORAGE_SIZE_GB=10

# Postgres database and schema that hold the IoT tables (lowercase).
PG_DATABASE_NAME=postgres
PG_SCHEMA_NAME=public

# Entry name in ~/.pg_service.conf (the password lives in ~/.pgpass, mode 600).
# Same layout as Cortex Code's Postgres skill. Connect any time with:
#   psql "service=iot_mirror_lab"
PG_SERVICE_NAME=iot_mirror_lab
# (default: snowflake_admin)
PG_USER=snowflake_admin

# ################################################
# Postgres Network Policy (create mode only)
# ################################################

PG_NETWORK_RULE_NAME=IOT_MIRROR_LAB_PG_INGRESS_RULE
PG_NETWORK_POLICY_NAME=IOT_MIRROR_LAB_PG_INGRESS_POLICY
# CIDR allowed to reach Postgres on port 5432. AUTO = your current public IP as
# seen by Snowflake (CURRENT_IP_ADDRESS()/32). Re-run `task pg-allow-my-ip`
# whenever your IP changes. 0.0.0.0/0 is refused.
# (default: AUTO)
PG_ALLOWED_CIDR=AUTO

# ################################################
# Mirror
# ################################################

# Lowercase letters, digits, and underscores; 50 characters or fewer
# (mirror names fold to lowercase).
MIRROR_NAME=iot_mirror

# Snowflake database that CREATE_MIRROR creates. It must NOT exist, and a name
# can NEVER be reused, even after the mirror and database are dropped. Bump the
# suffix before every new mirror (e.g. _01 -> _02).
MIRROR_TARGET_DATABASE_NAME=IOT_MIRROR_DB_01

# How often the apply task merges changes into the target tables. One of:
# '30 seconds', '1 minute', '10 minutes', '1 hour', '1 day'.
# $live views stay ~30s fresh regardless.
MIRROR_REFRESH_INTERVAL='1 minute'

# SNOWFLAKE = standard Snowflake tables; ICEBERG = Snowflake-managed Iceberg tables.
# (default: SNOWFLAKE)
MIRROR_TARGET_TABLE_TYPE=SNOWFLAKE

# Faster cadence that lab-6 applies temporarily to demonstrate ALTER_MIRROR.
MIRROR_FAST_REFRESH_INTERVAL='30 seconds'

# ################################################
# Analytics (lab-7)
# ################################################

# Created in DEMO_DATABASE_NAME.DEMO_SCHEMA_NAME. The Cortex Agent requires
# Enterprise edition.
DEMO_DYNAMIC_TABLE_NAME=SITE_HOURLY_METRICS
DEMO_SEMANTIC_VIEW_NAME=IOT_MIRROR_SV
DEMO_AGENT_NAME=IOT_MIRROR_AGENT

# ################################################
# Lab Verification
# ################################################

# How long each lab step waits for Snowflake to converge with Postgres.
# (default: 300)
LAB_SYNC_TIMEOUT_SECONDS=300
# (default: 10)
LAB_POLL_INTERVAL_SECONDS=10

# ################################################
# Load Generator (task stream-readings)
# ################################################

# (default: 5)
STREAM_INTERVAL_SECONDS=5
# Number of batches; 60 x 5s = 5 minutes. (default: 60)
STREAM_BATCHES=60
# Readings inserted per batch. (default: 20)
STREAM_BATCH_SIZE=20
